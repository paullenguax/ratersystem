Options -MultiViews
RewriteEngine On
RewriteBase /ratersystem/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  # Vite fingerprints every build asset (index-<hash>.js etc.), so a given
  # filename's contents never change — cache it hard and skip revalidation.
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpe?g|gif|svg|webp|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html is the one unfingerprinted file and points at the current
  # hashed bundle. It MUST be revalidated every load, otherwise a deploy
  # stays invisible behind the browser/SiteGround cache until it happens to
  # expire on its own. This also covers every SPA route rewritten to it above.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
