Options -MultiViews
RewriteEngine On
RewriteBase /ratersystem/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  # Vite fingerprints every build asset (index-<hash>.js, practice-<hash>.js,
  # <name>-<hash>.css, images) so a given filename's contents never change —
  # cache hard, no revalidation.
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpe?g|gif|svg|webp|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The unfingerprinted files MUST be revalidated every load:
  #  - index.html / SPA routes: point at the current hashed admin bundle.
  #  - player-shell/*.html + .vite/manifest.json: the Test Versions exporter
  #    fetch()es these from the browser at export time, so a stale copy here
  #    means a freshly re-exported sample test silently ships the OLD player.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "manifest\.json$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
